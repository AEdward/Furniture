# Some hosts (cPanel's "Production" Node.js App mode, notably) export
# NODE_ENV=production before running npm install — npm's default
# behavior in that case is to skip devDependencies entirely. That
# breaks this project's build, which needs typescript and tailwindcss
# (both devDependencies) at build time even though the app runs in
# production afterward. This forces them to install regardless of
# NODE_ENV, on every `npm install` — terminal or cPanel's own
# "Run NPM Install" button alike.
include=dev
