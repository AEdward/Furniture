# MySQL connection. Point these at your own database (a local MariaDB/MySQL
# server, or the one started via `docker compose up -d`).
DB_HOST=localhost
DB_PORT=3306
DB_USER=furniture_app
DB_PASSWORD=furniture_dev_pw
DB_NAME=zemenay

# Admin dashboard (/admin). Pick your own values — ADMIN_PASSWORD is the
# shared password to sign in; ADMIN_SESSION_SECRET signs the login cookie
# and should be a long random string.
ADMIN_PASSWORD=changeme
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Amharic/Oromo auto-translation (see "Language" in the README). Optional —
# without this set, the language switcher still appears but every string
# falls back to English instead of calling the translation API. Get a key
# from Google Cloud Console: enable the "Cloud Translation API" on a
# project, then create an API key under APIs & Services > Credentials.
GOOGLE_TRANSLATE_API_KEY=
