# MySQL connection. Point these at your own database (a local MariaDB/MySQL
# server, or the one started via `docker compose up -d`).
DB_HOST=localhost
DB_PORT=3306
DB_USER=furniture_app
DB_PASSWORD=furniture_dev_pw
DB_NAME=zemenay

# Admin dashboard (/portal2026). Named admin accounts live in the database
# (add/remove more at /portal2026/users once you're in) — ADMIN_EMAIL and
# ADMIN_PASSWORD are only used once, by `npm run seed`, to create the
# very first account. Change or remove that account's password from
# /portal2026/users after logging in; editing these two afterward does
# nothing. ADMIN_SESSION_SECRET signs the login cookie and should be a
# long random string — changing it logs everyone out.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Optional — hides /portal2026 behind a shared secret instead of a guessable
# URL. Unset, /portal2026 works as normal. Set, every /portal2026* path 404s for
# anyone without it: visit /portal2026?key=<this value> once and the browser
# remembers for ~a year via a signed cookie, after which /portal2026/login
# works normally. Generate one with `openssl rand -hex 24`.
ADMIN_GATE_KEY=

# Translation (see "Language" in the README). Optional — languages,
# whether auto-translation runs at all, and manual per-string overrides
# are all managed from /portal2026/settings and /portal2026/translations. Without
# this set, auto-translation is a no-op and every string falls back to
# English (or whatever's been filled in by hand) — a missing or failing
# translation call never breaks the page. Get a key from Google Cloud
# Console: enable the "Cloud Translation API" on a project, then create
# an API key under APIs & Services > Credentials.
GOOGLE_TRANSLATE_API_KEY=

# Chapa payment (see "Payment" in the README). Required for checkout to
# actually charge a customer — without it, checkout still creates the
# order but shows an error instead of redirecting to pay, so nothing
# is silently faked as paid. Get a secret key (test or live) from your
# Chapa dashboard: https://dashboard.chapa.co > API Keys.
CHAPA_SECRET_KEY=

# Absolute base URL of this deployment, used to build the callback/return
# URLs Chapa redirects to. Defaults to the incoming request's own origin
# if unset, which is fine for a single-domain deploy — set this
# explicitly if you're behind a proxy/CDN that changes the origin.
APP_BASE_URL=http://localhost:3000

# Transactional email (order confirmations, shipping status updates, and
# new contact-form notifications to SMTP_FROM/settings.email). Optional —
# without SMTP_HOST/SMTP_USER/SMTP_PASSWORD set, sendEmail is a no-op
# that just logs, so nothing that triggers an email ever breaks because
# it isn't configured. Point these at any SMTP provider (e.g. Gmail App
# Passwords, SendGrid, Mailgun, Amazon SES).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Error monitoring (Sentry). Optional — without SENTRY_DSN set, nothing
# is captured or sent anywhere, so unset behaves exactly like today.
# Set it and every server-side error (an unexpected 500, an unhandled
# promise rejection, a crash) is reported to Sentry instead of only
# showing up in server logs — so a broken checkout or a failed payment
# webhook surfaces before a customer has to report it. Get a DSN by
# creating a project at https://sentry.io.
SENTRY_DSN=
